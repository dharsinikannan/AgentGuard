# Copy to .env and fill in. .env is gitignored; never commit real keys.
LOCALSTACK_AUTH_TOKEN=
GROQ_API_KEY=

# Milestone 6: OAuth. Generate each key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTGUARD_TOKEN_KEY=      # gateway: encrypts its per-user tokens
GITHUB_MCP_TOKEN_KEY=      # GitHub MCP server: encrypts users' GitHub tokens (a different service, a different key)
# Fake GitHub (python -m servers.fake_github): these exact values. Real GitHub: your GitHub App's.
GITHUB_CLIENT_ID=Iv1.fake
GITHUB_CLIENT_SECRET=fake-secret
GITHUB_OAUTH_URL=http://127.0.0.1:9100
GITHUB_API_URL=http://127.0.0.1:9100
